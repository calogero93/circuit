
# Un solo servizio tutor: FastAPI + LangGraph. Le credenziali restano sul server.
LLM_PROVIDER=local
# Endpoint locale compatibile con chat completions e tool calling (LM Studio, ecc.).
LLM_BASE_URL=http://127.0.0.1:1235/v1
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=local
LLM_TEMPERATURE=0
# Opzionali, solo se supportati dal runtime locale:
# LLM_SEED=42
# LLM_MAX_OUTPUT_TOKENS=4096
# Metadati esperimenti LLMOps (dichiarazioni, non rilevamento automatico):
# LLM_MODEL_REVISION=revisione-dei-pesi
# LLM_MODEL_QUANTIZATION=Q4_K_M
# LLM_MODEL_SHA256=hash-sha256-del-file-pesi
# LLM_MODEL_FILE=/percorso/al/modello.gguf
# LLM_RUNTIME_NAME=LM Studio
# LLM_RUNTIME_VERSION=versione-installata
# LLM_HARDWARE_ID=profilo-hardware-locale
# RAG_CORPUS_REVISION=revisione-del-corpus

AI_SERVICE_URL=http://127.0.0.1:8080
TOOL_BRIDGE_URL=ws://127.0.0.1:8787
TOOL_BRIDGE_PORT=8787
# Origini browser ammesse (nessuna wildcard; solo localhost). Per una porta Vite diversa:
# TOOL_BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
# Il relay resta sempre su 127.0.0.1. Le capability ruotano a ogni avvio;
# quella del tutor vive nel runtime privato dell'utente, fuori dal repository.
# XDG_RUNTIME_DIR privato, altrimenti directory temporanea privata per utente/check-out.
# Non usare VITE_* per capability o credenziali. Nessuna configurazione token richiesta.
# Il browser usa /tool-bridge attraverso Vite. Override facoltativo:
# VITE_TOOL_BRIDGE_URL=ws://127.0.0.1:8787
# PostgreSQL locale: docker compose up -d --wait postgres
POSTGRES_DB=circuit
POSTGRES_USER=circuit
POSTGRES_PASSWORD=circuit
POSTGRES_PORT=5433
DATABASE_URL=postgresql://circuit:circuit@127.0.0.1:5433/circuit
# Token stimati con rapporto conservativo caratteri/token, non tokenizer esatto.
AI_SUMMARY_THRESHOLD_TOKENS=6000
AI_CONTEXT_MAX_TOKENS=12000
AI_KEEP_RECENT_TURNS=3
AI_MAX_TOOL_ROUNDS=8
# Budget dell'intero turno: riassunto, chiamate LLM, tool e salvataggio memoria.
AI_REQUEST_TIMEOUT=300
# AI_DATA_DIR=/percorso/ai-data  # solo indice RAG facoltativo

# RAG opzionale: uv run --extra rag python -m circuit_ai.rag.index /percorso/documenti
RAG_ENABLED=false

# Solo con scelta esplicita del provider cloud e del relativo modello:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=...
# LLM_MODEL=...
# Rimuovi LLM_BASE_URL per usare l'endpoint predefinito del provider.
# LLM_PROVIDER=anthropic richiede anche uv sync --extra anthropic
# ANTHROPIC_API_KEY=...
