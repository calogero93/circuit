# Copia in .env (o esporta nell'ambiente) prima di `npm run proxy`.
# La chiave NON deve mai finire nel bundle client.
ANTHROPIC_API_KEY=sk-ant-...
# Facoltativo: modello usato dal tutor (default nel proxy)
# ANTHROPIC_MODEL=claude-sonnet-5

# Tool-bridge (esposizione dei tool via WebSocket a un client esterno).
# Metti questo in .env.local per far connettere il browser al relay:
# VITE_TOOL_BRIDGE_URL=ws://localhost:8787
