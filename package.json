{
  "name": "circuit-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Piattaforma didattica per imparare l'elettronica costruendo e simulando circuiti",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/engine/*.test.ts\"",
    "test:e2e": "playwright test",
    "proxy": "node server/proxy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "katex": "^0.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
